# Variables d'environnement — Tifo
# Copiez ce fichier en .env.local et remplissez les valeurs

# NextAuth
NEXTAUTH_SECRET=changeme_generate_with_openssl_rand_base64_32
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=changeme_generate_with_openssl_rand_base64_32

# OpenAI
OPENAI_API_KEY=sk-...

# Base de données PostgreSQL — Neon (gratuit, pas de pausing)
# Format : postgresql://user:password@region.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@us-east-1.neon.tech/tifo?sslmode=require

# Emails admin (séparés par virgule)
TIFO_ADMIN_EMAILS=admin@example.com

# Stockage des affiches — Vercel Blob (gratuit jusqu'à 1GB)
BLOB_READ_WRITE_TOKEN=changeme_copy_from_vercel_storage

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_PRO=https://buy.stripe.com/...
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_CLUB=https://buy.stripe.com/...

# Emails — Resend (prioritaire)
RESEND_API_KEY=re_...

# Emails — SMTP Nodemailer (fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ton@email.com
SMTP_PASS=ton_mot_de_passe_app
SMTP_FROM=Tifo <noreply@tifo.nanocorp.app>
